%%{init: {'theme':'dark','themeVariables':{'fontSize':'12px'}}}%%
flowchart TD
  Q(["Motor does not move when I press Enable / run"]) --> D1{"D group green?"}
  D1 -- "D1 red" --> X1["Port not open: pick the Teensy port, re-plug USB"]
  D1 -- "D2 red" --> X2["Port silent: Teensy not running firmware\n→ reset / flash"]
  D1 -- "D3 red" --> X3["Bytes but no frames: protocol version / baud / cable"]
  D1 -- "D5 red" --> X4["We hear it, it does not hear us:\nUSB TX side / parser rejects our CRC"]
  D1 -- "all green" --> B{"B group?"}
  B -- "B1 blocked" --> X5["Idle switch open (pin 22). Close it."]
  B -- "B2 fail" --> X6["Trip latched: read the trip name + explanation,\nfix cause, Clear trip"]
  B -- "green" --> A{"A group?"}
  A -- "A1 red" --> X7["CAN controller bus-off: transceiver power/STBY,\nCAN_H/L swapped, termination"]
  A -- "A2 red" --> X8["TX not ACKed: nobody on the bus\n(motor unpowered)"]
  A -- "A3/A4 blocked" --> X9["Motor never answers: 24 V supply, CAN id\n(Settings → Scan bus), motor fault LED"]
  A -- "A4 fail while enabled" --> X10["Replies stopped mid-run: power dropout → TRIP_CAN_LOST"]
  A -- "A5 red" --> X11["Frozen / NaN replies: encoder or driver;\npower-cycle, re-run motor calibration"]
  A -- "green" --> C{"C group?"}
  C -- "C2 blocked" --> X12["Not zeroed / no limits: trajectories refused\n→ Calibration tab"]
  C -- "C3 blocked" --> X13["Calibration running: wait or abort"]
  C -- "C1 red" --> X14["Loop overruns: OLED/I2C stall or firmware bug"]
  C -- "green" --> S{"Controller state?"}
  S -- "REST" --> X15["Press Enable (now allowed). If it bounces back,\nread the Events pane: the Teensy says why"]
  S -- "HOLD but no motion" --> X16["Gains too low vs friction → raise Kp / add Ki;\nslider only moves HOLD; stream needs TRAJ"]
  S -- "FREE-SPIN" --> X17["Zero torque by design → Re-grip"]
